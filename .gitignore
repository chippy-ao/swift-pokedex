# SwiftPM
.build/
# .swiftpm の中は共有 scheme（LogicTests.xcscheme）だけを追跡する。
# 理由: ロジックのテスト target だけを入れた scheme は、手で書かないと作れない（SwiftPM の自動生成は全 target を入れる）。
.swiftpm/*
!.swiftpm/xcode/
.swiftpm/xcode/*
!.swiftpm/xcode/xcshareddata/
.swiftpm/xcode/xcshareddata/*
!.swiftpm/xcode/xcshareddata/xcschemes/

# Xcode
DerivedData/
xcuserdata/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/configuration/

# mise run test の結果バンドル
build/

# macOS
.DS_Store

# claude
.claude/